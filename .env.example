# Copy this file to .env and replace every password with a unique value.
# Use long, random values. MYSQL_EXPORTER_PASSWORD must use only A-Z, a-z, 0-9, _ or -.
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD
MYSQL_EXPORTER_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_EXPORTER_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_CMS_PASSWORD
SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_GRAFANA_PASSWORD

# Gmail password recovery (use a Google App Password, not your Google account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-address@gmail.com
SMTP_PASS=REPLACE_WITH_GOOGLE_APP_PASSWORD
MAIL_FROM=your-address@gmail.com

# Optional local port overrides
WEB_PORT=8080
PMA_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Set true only after terminating HTTPS in front of this stack.
COOKIE_SECURE=false
